version = 5.5.0
archive_dir = /etc/letsencrypt/archive/vezuroll.ru
cert = /etc/letsencrypt/live/vezuroll.ru/cert.pem
privkey = /etc/letsencrypt/live/vezuroll.ru/privkey.pem
chain = /etc/letsencrypt/live/vezuroll.ru/chain.pem
fullchain = /etc/letsencrypt/live/vezuroll.ru/fullchain.pem
[renewalparams]
account = e13b4d254853aecb6e89d3942b242699
authenticator = webroot
webroot_path = /var/www/certbot,
server = https://acme-v02.api.letsencrypt.org/directory
key_type = ecdsa
[[webroot_map]]
vezuroll.ru = /var/www/certbot
www.vezuroll.ru = /var/www/certbot
[acme_renewal_info]
ari_retry_after = 2026-09-28T17:02:35
